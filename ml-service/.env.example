# ----------------------------------------------------------------------
# Insta-V2 Django ML Service Environment Configuration Template
# Copy this file to ml-service/.env for local development
# ----------------------------------------------------------------------

# Django Secret Key (required in production; generate with python -c 'import secrets; print(secrets.token_urlsafe(50))')
DJANGO_SECRET_KEY=replace_with_a_strong_random_django_secret_key

# Debug Mode (MUST be false in production)
DEBUG=false
DJANGO_DEBUG=false

# Allowed Hosts (comma-separated domain names)
ALLOWED_HOSTS=localhost,127.0.0.1,.onrender.com
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,.onrender.com

# Service Port (set automatically by Render via $PORT, defaults to 8001 locally)
PORT=8001
DISABLE_COLLECTSTATIC=1

# Shared secret for Node.js <-> Django internal service authentication
# Must match ML_SERVICE_SECRET / ML_INTERNAL_API_KEY in server/.env
INTERNAL_SERVICE_SECRET=replace_with_shared_internal_service_secret
ML_INTERNAL_API_KEY=replace_with_shared_internal_service_secret
