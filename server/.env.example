# ----------------------------------------------------------------------
# Insta-V2 Express Backend Environment Configuration Template
# Copy this file to server/.env for local development
# ----------------------------------------------------------------------

# Server Environment & Port
PORT=8000
NODE_ENV=development

# Allowed Frontend Origins (comma-separated, no trailing slash)
# Local: http://localhost:5173
# Production on Render: https://your-site.netlify.app
CLIENT_URL=http://localhost:5173

# MongoDB Atlas Connection URI
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/instaV2db?retryWrites=true&w=majority

# JWT Session Authentication
JWT_SECRET=your_super_secret_jwt_key_at_least_32_characters_long
JWT_EXPIRES_IN=7d

# Cloudinary Signed Media Storage
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
CLOUDINARY_UPLOAD_PRESET=insta_v2

# Independent Django ML Recommendation Service
ML_SERVICE_URL=http://127.0.0.1:8001
ML_SERVICE_SECRET=replace_with_shared_internal_service_secret
ML_INTERNAL_API_KEY=replace_with_shared_internal_service_secret
ML_TIMEOUT_MS=3500
ML_MAX_RETRIES=1
ML_CIRCUIT_FAILURE_THRESHOLD=3
ML_CIRCUIT_COOLDOWN_MS=30000

# Recommendation Caching (Redis optional; automatic in-memory LRU fallback)
REDIS_URL=
RECOMMENDATION_CACHE_TTL_SEC=300
RECOMMENDATION_MEMORY_CACHE_MAX=500
RECOMMENDATION_INVALIDATION_COOLDOWN_MS=2000

# Candidate Pool Sizing for Freshness & Shuffling
RECOMMENDATION_POOL_SIZE_USERS=50
RECOMMENDATION_POOL_SIZE_POSTS=80
RECOMMENDATION_POOL_SIZE_REELS=60
