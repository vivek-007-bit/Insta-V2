PORT=8000
NODE_ENV=development
# Comma-separated list of allowed frontend origins (no trailing slash)
# Example for production on Render: CLIENT_URL=https://your-site.netlify.app
CLIENT_URL=http://localhost:5173
# Optional override:
# COOKIE_SAME_SITE=none

# MongoDB Connection String
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/instaV2db?retryWrites=true&w=majority

# JWT Authentication
JWT_SECRET=your_super_secret_jwt_key_at_least_32_characters_long
JWT_EXPIRES_IN=7d

# Cloudinary Media Storage
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_PRESET=
