# Insta-V2 React Frontend Environment Configuration Template
# Copy this file to client/.env for local development

# ----------------------------------------------------------------------
# API Base URL
# ----------------------------------------------------------------------
# Local Development: http://localhost:8000/api
# Production with Netlify Proxy (recommended): /api
# Production Direct Render Host: https://your-backend-host.onrender.com/api
VITE_API_BASE_URL=http://localhost:8000/api

# ----------------------------------------------------------------------
# Real-Time Socket.IO URL
# ----------------------------------------------------------------------
# Local Development: http://localhost:8000 (must be HTTP, not HTTPS)
# Production: https://your-backend-host.onrender.com (HTTPS for secure WSS connection)
VITE_SOCKET_URL=http://localhost:8000

# ----------------------------------------------------------------------
# Cloudinary Public Cloud Name
# ----------------------------------------------------------------------
# Public cloud identifier used for media URL construction (never put API secret here)
VITE_CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
